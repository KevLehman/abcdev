---
import { socialProfiles } from '../lib/structured-data.mjs';
interface Props { lang?: 'en' | 'es'; }
const { lang = 'en' } = Astro.props;
---
<footer>
  <div class="wrap foot">
    <span>© 2026 Kevin Aleman</span>
    <div class="foot-links">
      <a href={lang === 'es' ? '/es/feed.xml' : '/feed.xml'} data-rss-link data-en="Subscribe via RSS" data-es="Suscribirse por RSS">{lang === 'es' ? 'Suscribirse por RSS' : 'Subscribe via RSS'}</a>
      <span>{socialProfiles.map((s, i) => (<>{i > 0 && ' · '}<a href={s.href}>{s.label}</a></>))}</span>
    </div>
  </div>
</footer>
<style>
  footer { border-top: 1px solid var(--hairline); margin-top: 40px; }
  .foot { display: flex; justify-content: space-between; padding-block: 26px;
    font-family: var(--font-mono); font-size: .74rem; color: var(--slate); }
  .foot a { color: var(--slate); text-decoration: none; }
  .foot a:hover { color: var(--signal); }
  .foot-links { display: flex; flex-wrap: wrap; gap: 12px 24px; }
  @media (max-width: 640px) { .foot { flex-direction: column; gap: 8px; } }
</style>
