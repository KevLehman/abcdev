---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import KeepReading from '../components/KeepReading.astro';
import SeriesNavigation from '../components/SeriesNavigation.astro';
import CollaborationDisclosure from '../components/CollaborationDisclosure.astro';
import MurderMystery from '../components/MurderMystery.astro';
import Subscribe from '../components/Subscribe.astro';
import { oembedHref } from '../lib/oembed.mjs';
import { pickRelatedArticle } from '../lib/related-articles.mjs';
import { getArticleSeries } from '../lib/article-series.mjs';
import { articlePath, translationFor } from '../lib/article-language.mjs';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  const english = articles.filter((a) => a.data.lang === 'en');
  const translations = articles.filter((a) => a.data.lang === 'es' && a.data.translationOf && !a.data.unlisted);
  for (const translated of translations) {
    if (!english.some((en) => en.id === translated.data.translationOf && !en.data.unlisted)) {
      throw new Error(`Spanish article "${translated.id}" must reference a published, listed English article.`);
    }
    if (translations.filter((a) => a.data.translationOf === translated.data.translationOf).length > 1) {
      throw new Error(`More than one Spanish article translates "${translated.data.translationOf}".`);
    }
  }
  for (const spanish of articles.filter((a) => a.data.lang === 'es' && (!a.data.translationOf || a.data.unlisted))) {
    if (english.some((en) => articlePath(en) === articlePath(spanish))) {
      throw new Error(`Spanish article "${spanish.id}" conflicts with an English article path.`);
    }
  }
  const standalone = articles.filter((a) => a.data.lang === 'es' && !english.some((en) => articlePath(en) === articlePath(a)));
  return [...english, ...standalone].map((article) => ({ params: { slug: articlePath(article).slice(1, -1) }, props: { article } }));
}

interface Props { article: CollectionEntry<'articles'>; }
const { article } = Astro.props;
const allArticles = await getCollection('articles');
const translation = translationFor(article, allArticles);
const variants = await Promise.all([article, ...(translation ? [translation] : [])].map(async (entry) => {
  const { Content, headings, remarkPluginFrontmatter } = await render(entry);
  const articles = allArticles.filter((a) => a.data.lang === entry.data.lang);
  const pick = pickRelatedArticle(entry, articles);
  let rec = null;
  if (pick) {
    const { remarkPluginFrontmatter: fm } = await render(pick);
    rec = {
      href: `${articlePath(pick)}${pick.data.lang === 'es' ? '?lang=es' : ''}`, idx: pick.data.idx, date: pick.data.date,
      rt: fm.minutesRead ?? '1 min read', title: pick.data.title, tags: pick.data.tags,
    };
  }
  return {
    article: entry, lang: entry.data.lang, Content, rec,
    rt: remarkPluginFrontmatter.minutesRead ?? '1 min read',
    toc: headings.filter((h) => h.depth === 2),
    iso: entry.data.date.toISOString().slice(0, 10),
    series: getArticleSeries(entry, articles),
    ogImage: entry.data.featuredImage?.src ?? entry.data.coverImage ?? `/og/${entry.id}.png`,
    oembed: entry.data.unlisted ? undefined : oembedHref(entry.id, Astro.site),
  };
}));
const { lang, ogImage, oembed } = variants[0];
---
<Base title={`${article.data.title} — Kev's logbook`} description={article.data.excerpt}
      canonical={`${articlePath(article)}${lang === 'es' ? '?lang=es' : ''}`}
      ogImage={ogImage} oembed={oembed} markdown={`/markdown/${article.id}.md`} lang={lang}
      alternate={translation ? `${articlePath(article)}${lang === 'en' ? '?lang=es' : ''}` : undefined}
      article={{ title: article.data.title, publishedTime: article.data.date, tags: article.data.tags }} noindex={article.data.unlisted}>
  {variants.map(({ article, lang, Content, rec, rt, toc, iso, series, ogImage, oembed }, index) => (
  <article class="wrap post" lang={lang} data-language-article={lang} data-title={`${article.data.title} — Kev's logbook`} data-headline={article.data.title} data-description={article.data.excerpt} data-og-image={new URL(ogImage, Astro.site).href} data-oembed={oembed} data-markdown={new URL(`/markdown/${article.id}.md`, Astro.site).href} hidden={index !== 0}>
    <a class="back" href={lang === 'es' ? '/es/' : '/'}>← {lang === 'es' ? 'bitácora' : 'logbook'} / {String(article.data.idx).padStart(3, '0')}</a>
    <h1>{article.data.title}</h1>
    <div class="readout">
      <span>{lang === 'es' ? 'fecha' : 'date'} {iso}</span><span>·</span><span>{lang === 'es' ? 'lectura' : 'read'} {rt.replace(' min read', 'm')}</span>
      <span>·</span><span>{lang === 'es' ? 'etiquetas' : 'tags'} {article.data.tags.map((tag, i) => (<>{i > 0 && ', '}<a href={`${lang === 'es' ? '/es/' : '/'}#${encodeURIComponent(tag)}`}>{tag}</a></>))}</span>
      {article.data.devtoUrl && (<><span>·</span><a href={article.data.devtoUrl}>{lang === 'es' ? 'también en dev.to' : 'also on dev.to'} ↗</a></>)}
    </div>
    {article.data.collaboration && <CollaborationDisclosure collaboration={article.data.collaboration} lang={lang} />}
    {series && (
      <p class="series-note">{lang === 'es' ? 'Parte' : 'Part'} {series.position} {lang === 'es' ? 'de' : 'of'} {series.articles.length} {lang === 'es' ? 'en' : 'in'} <a href="#article-series">{series.title}</a>.</p>
    )}
    {article.data.featuredImage
      ? <Image class="hero-img" src={article.data.featuredImage} alt={article.data.title} widths={[400, 800, 1200]}
          sizes="(max-width: 680px) calc(100vw - 40px), 620px" loading="eager" fetchpriority="high" />
      : article.data.coverImage && <img class="hero-img" src={article.data.coverImage} alt={article.data.title} loading="eager" fetchpriority="high" decoding="async" />}
    {toc.length >= 3 && (
      <nav class="toc" aria-label={lang === 'es' ? 'Contenido' : 'Contents'}>
        <p class="eyebrow">// {lang === 'es' ? 'contenido' : 'contents'}</p>
        <ol>
          {toc.map((h, i) => (
            <li><a href={`#${h.slug}`}><span class="toc-idx">{String(i + 1).padStart(2, '0')}</span>{h.text}</a></li>
          ))}
        </ol>
      </nav>
    )}
    <div class="prose"><Content /></div>
    {article.id === 'can-ai-solve-a-murder-mystery' && <MurderMystery />}
    <Subscribe lang={lang} />
    {series && <SeriesNavigation series={series} lang={lang} />}
    {rec && <KeepReading {...rec} lang={lang} />}
  </article>
  ))}
  {translation && <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const variants = document.querySelectorAll('[data-language-article]');
      const selected = new URLSearchParams(location.search).get('lang');
      const article = Array.from(variants).find((node) => node.dataset.languageArticle === selected) || variants[0];
      variants.forEach((node) => {
        node.hidden = node !== article;
        if (node.hidden) node.querySelectorAll('[id]').forEach((element) => element.removeAttribute('id'));
      });
      document.documentElement.lang = article.lang;
      document.querySelectorAll('[data-en][data-es]').forEach((node) => { node.textContent = node.dataset[article.lang]; });
      document.querySelector('[data-rss-link]').href = article.lang === 'es' ? '/es/feed.xml' : '/feed.xml';
      document.querySelector('link[type="application/rss+xml"]').href = article.lang === 'es' ? '/es/feed.xml' : '/feed.xml';
      const switcher = document.querySelector('[data-language-switch]');
      switcher.href = article.lang === 'es' ? '?lang=en' : '?lang=es';
      switcher.lang = article.lang === 'es' ? 'en' : 'es';
      switcher.textContent = article.lang === 'es' ? 'English' : 'Español';
      document.querySelector('.wordmark').href = article.lang === 'es' ? '/es/' : '/';
      const logbook = document.querySelector('nav a[href="/"]');
      if (logbook && article.lang === 'es') { logbook.href = '/es/'; logbook.textContent = 'bitácora'; }
      document.getElementById('search-open')?.setAttribute('aria-label', article.lang === 'es' ? 'Buscar en la bitácora' : 'Search the logbook');
      document.getElementById('search')?.setAttribute('aria-label', article.lang === 'es' ? 'Buscar en la bitácora' : 'Search the logbook');
      const input = document.getElementById('search-input');
      input.placeholder = article.lang === 'es' ? 'buscar artículos…' : 'search entries…';
      input.setAttribute('aria-label', article.lang === 'es' ? 'Buscar artículos' : 'Search entries');
      document.getElementById('search-results')?.setAttribute('aria-label', article.lang === 'es' ? 'Resultados' : 'Results');
      const theme = document.getElementById('theme-toggle');
      if (theme && article.lang === 'es') theme.setAttribute('aria-label', theme.getAttribute('aria-label').replace('Switch to dark theme', 'Cambiar al tema oscuro').replace('Switch to grove theme', 'Cambiar al tema bosque').replace('Switch to light theme', 'Cambiar al tema claro'));
      document.title = article.dataset.title;
      for (const selector of ['meta[name="description"]', 'meta[property="og:description"]', 'meta[name="twitter:description"]']) document.querySelector(selector)?.setAttribute('content', article.dataset.description);
      for (const selector of ['meta[property="og:title"]', 'meta[name="twitter:title"]']) document.querySelector(selector)?.setAttribute('content', article.dataset.title);
      for (const selector of ['meta[property="og:image"]', 'meta[name="twitter:image"]']) document.querySelector(selector)?.setAttribute('content', article.dataset.ogImage);
      document.querySelector('link[type="application/json+oembed"]')?.setAttribute('href', article.dataset.oembed);
      document.querySelector('link[type="text/markdown"]')?.setAttribute('href', article.dataset.markdown);
      const structured = document.querySelector('script[type="application/ld+json"]');
      if (structured) {
        const json = JSON.parse(structured.textContent);
        const post = json['@graph'].find((node) => node['@type'] === 'BlogPosting');
        if (post) Object.assign(post, { headline: article.dataset.headline, description: article.dataset.description, image: article.dataset.ogImage, inLanguage: article.lang });
        structured.textContent = JSON.stringify(json).replace(/</g, '\\u003c');
      }
    });
  </script>}
  <script is:inline>
    // Progressive enhancement: while an article image is still loading, show a
    // shimmer placeholder instead of empty space (or a half-painted image). The
    // class is added/removed only by JS, so no-JS visitors see normal images and
    // transparent images never keep a stray backdrop after they load.
    (() => {
      const enhance = () => {
        document.querySelectorAll('article img').forEach((img) => {
          const clear = () => img.classList.remove('is-loading');
          if (img.complete && img.naturalWidth > 0) return clear();
          img.classList.add('is-loading');
          img.addEventListener('load', clear, { once: true });
          img.addEventListener('error', clear, { once: true });
        });
      };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', enhance);
      else enhance();
    })();
  </script>
  <script is:inline>
    // Copy buttons on code blocks. Each pre is wrapped so the button can anchor
    // to the box instead of scrolling away with wide code. JS-only, so no-JS
    // readers just see plain code blocks.
    (() => {
      if (!navigator.clipboard) return;
      document.querySelectorAll('.prose pre.astro-code').forEach((pre) => {
        const wrap = document.createElement('div');
        wrap.className = 'code-wrap';
        pre.parentNode.insertBefore(wrap, pre);
        wrap.appendChild(pre);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'code-copy';
        const es = document.documentElement.lang === 'es';
        btn.textContent = es ? 'copiar' : 'copy';
        btn.setAttribute('aria-label', es ? 'Copiar código' : 'Copy code to clipboard');
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText((pre.querySelector('code') ?? pre).innerText.trimEnd() + '\n');
            btn.textContent = es ? 'copiado ✓' : 'copied ✓';
            btn.classList.add('did');
          } catch {
            btn.textContent = es ? 'error' : 'failed';
          }
          setTimeout(() => { btn.textContent = es ? 'copiar' : 'copy'; btn.classList.remove('did'); }, 1600);
        });
        wrap.appendChild(btn);
      });
    })();
  </script>
  <script is:inline>
    // Custom selection painting: the native highlight fills each line to the
    // column edge, so we hide it inside .prose and draw our own rectangles from
    // Range.getClientRects(), which hug the actual text. The real selection is
    // untouched, so copy/paste and the recolored text still work.
    (() => {
      const prose = document.querySelector('.prose');
      if (!prose || !window.requestAnimationFrame) return;
      document.documentElement.classList.add('sel-custom');
      const layer = document.createElement('div');
      layer.className = 'sel-prose-layer';
      layer.setAttribute('aria-hidden', 'true');
      prose.prepend(layer);
      let raf = 0;
      const paint = () => {
        raf = 0;
        layer.textContent = '';
        const sel = getSelection();
        if (!sel || sel.isCollapsed || !sel.rangeCount) return;
        const range = sel.getRangeAt(0);
        if (!range.intersectsNode(prose)) return;
        const base = prose.getBoundingClientRect();
        const frag = document.createDocumentFragment();
        for (const r of range.getClientRects()) {
          if (r.width < 1 || r.height < 1) continue;
          if (r.bottom < base.top || r.top > base.bottom) continue;
          if (r.right < base.left || r.left > base.right) continue;
          const i = document.createElement('i');
          i.style.left = (r.left - base.left) + 'px';
          i.style.top = (r.top - base.top) + 'px';
          i.style.width = r.width + 'px';
          i.style.height = r.height + 'px';
          frag.appendChild(i);
        }
        layer.appendChild(frag);
      };
      const schedule = () => { if (!raf) raf = requestAnimationFrame(paint); };
      document.addEventListener('selectionchange', schedule);
      window.addEventListener('resize', schedule);
    })();
  </script>
</Base>
<style>
  .post { max-width: var(--measure); padding-top: 48px; }
  .back { font-family: var(--font-mono); font-size: .78rem; text-decoration: none; }
  h1 { font-family: var(--font-display); font-weight: 700; font-size: 2.6rem; line-height: 1.08;
    letter-spacing: -.02em; margin: 18px 0 16px; }
  .readout { font-family: var(--font-mono); font-size: .76rem; color: var(--slate);
    display: flex; flex-wrap: wrap; gap: 8px; padding: 12px 0; border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline); }
  .readout a { color: var(--signal); text-decoration: none; }
  .series-note { margin-top: 16px; font-size: .95rem; color: var(--slate); }
  .hero-img { width: 100%; height: auto; margin: 28px 0; }
  .toc { margin-top: 28px; padding: 16px 0 6px; border-top: 1px solid var(--hairline); }
  .toc ol { list-style: none; margin-top: 10px; }
  .toc li { border-bottom: 1px solid var(--hairline); }
  .toc li:last-child { border-bottom: 0; }
  .toc a { display: flex; gap: 14px; align-items: baseline; padding: 9px 0;
    font-family: var(--font-display); font-weight: 500; font-size: .95rem;
    color: var(--graphite); text-decoration: none; }
  .toc a:hover { color: var(--signal); }
  .toc-idx { font-family: var(--font-mono); font-weight: 400; font-size: .74rem; color: var(--slate); }
  .prose { font-size: 1.15rem; line-height: 1.7; }
  .prose :global(h2), .prose :global(h3) { scroll-margin-top: 24px; }
  .prose :global(img) { display: block; width: 100%; height: auto; margin: 1.5rem 0; }
  /* Loading placeholder: a soft shimmer while the bitmap streams in. The static
     background-color is the fallback when motion is reduced (animations are
     globally disabled there), so it degrades to a calm neutral block. */
  .hero-img.is-loading, .prose :global(img.is-loading) {
    min-height: 180px; background-color: var(--hairline); background-repeat: no-repeat;
    background-size: 200% 100%;
    background-image: linear-gradient(100deg, var(--hairline) 25%, var(--surface) 50%, var(--hairline) 75%);
    animation: img-shimmer 1.3s ease-in-out infinite;
  }
  @keyframes img-shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
  .prose :global(h2) { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; margin: 2rem 0 .6rem; }
  .prose :global(h3) { font-family: var(--font-display); font-weight: 500; font-size: 1.2rem; margin: 1.6rem 0 .5rem; }
  .prose :global(h4) { font-family: var(--font-display); font-weight: 500; font-size: 1.05rem; margin: 1.4rem 0 .5rem; }
  .prose :global(p) { margin: 0 0 1.1rem; }
  /* The global reset zeroes list padding; restore it so markers sit inside the
     column instead of hanging into the page margin (and clipping on phones). */
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.1rem; padding-left: 1.5rem; }
  .prose :global(li) { margin-bottom: .35rem; }
  .prose :global(li ul), .prose :global(li ol) { margin: .35rem 0 0; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--hairline); margin: 2rem 0; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 1.2rem; font-size: .98rem; line-height: 1.45; }
  .prose :global(th) { font-family: var(--font-mono); font-weight: 400; font-size: .72rem;
    letter-spacing: .08em; text-transform: uppercase; color: var(--slate); text-align: left; }
  .prose :global(th), .prose :global(td) { padding: 9px 14px 9px 0; border-bottom: 1px solid var(--hairline); vertical-align: top; }
  /* Shrink text blocks to their content so text selection hugs the words
     instead of painting the empty space out to the column edge. */
  .prose :global(p), .prose :global(li),
  .prose :global(h2), .prose :global(h3), .prose :global(h4),
  .prose :global(blockquote) { width: fit-content; max-width: 100%; }
  .prose :global(p:has(> img:only-child)) {
    width: 100%; margin: 1.5rem 0; padding: 10px; border: 1px solid var(--hairline); background: var(--surface);
  }
  .prose :global(p:has(> img:only-child) > img) { margin: 0; }
  .prose :global(p:has(> img:only-child):has(+ p > em:only-child)) { margin-bottom: 0; border-bottom: 0; }
  .prose :global(p:has(> img:only-child) + p:has(> em:only-child)) {
    width: 100%; margin: 0 0 1.5rem; padding: 4px 14px 14px; border: 1px solid var(--hairline);
    border-top: 0; background: var(--surface); color: var(--slate); font-size: .9rem; line-height: 1.5;
  }
  .prose :global(a) { color: var(--signal); }
  .prose :global(pre) { font-family: var(--font-mono); font-size: .9rem; padding: 16px;
    border: 1px solid var(--hairline); overflow-x: auto; margin: 0 0 1.2rem; }
  .prose :global(.code-wrap) { position: relative; margin: 0 0 1.2rem; }
  .prose :global(.code-wrap pre) { margin: 0; }
  .prose :global(.code-copy) { position: absolute; top: 8px; right: 8px;
    font-family: var(--font-mono); font-size: .68rem; letter-spacing: .02em; padding: 4px 9px;
    border: 1px solid var(--hairline); background: var(--surface); color: var(--slate);
    cursor: pointer; opacity: 0; transition: opacity .12s, color .12s, border-color .12s; }
  .prose :global(.code-wrap:hover .code-copy), .prose :global(.code-copy:focus-visible),
  .prose :global(.code-copy.did) { opacity: 1; }
  .prose :global(.code-copy:hover) { color: var(--signal); border-color: var(--signal); }
  .prose :global(.code-copy.did) { color: var(--signal); border-color: var(--signal); }
  @media (hover: none) { .prose :global(.code-copy) { opacity: 1; } }
  .prose :global(code) { font-family: var(--font-mono); font-size: .9em; }
  .prose :global(:not(pre) > code) { overflow-wrap: anywhere; background: var(--hairline); }
  .prose :global(blockquote) { border-left: 3px solid var(--signal); padding-left: 1rem; color: var(--slate); margin-bottom: 1.1rem; }
  /* Link card for `{% embed url %}` tags — mirrors the mono/hairline brand. */
  .prose :global(.embed-card) {
    display: flex; align-items: stretch; gap: 0; margin: 1.5rem 0; width: 100%; max-width: 100%;
    border: 1px solid var(--hairline); text-decoration: none; color: inherit;
    background: var(--surface); overflow: hidden; transition: border-color .15s ease;
  }
  .prose :global(.embed-card:hover) { border-color: var(--signal); }
  .prose :global(.embed-card__text) {
    display: flex; flex-direction: column; gap: 6px; padding: 16px; min-width: 0; flex: 1;
  }
  .prose :global(.embed-card__provider) {
    font-family: var(--font-mono); font-size: .72rem; letter-spacing: .02em;
    text-transform: lowercase; color: var(--slate);
  }
  .prose :global(.embed-card__title) {
    font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; line-height: 1.25;
    color: var(--graphite);
  }
  .prose :global(.embed-card__desc) {
    font-size: .92rem; line-height: 1.45; color: var(--slate);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .prose :global(.embed-card__thumb) {
    flex: 0 0 34%; max-width: 200px; margin: 0 !important; object-fit: cover; align-self: stretch;
    border-left: 1px solid var(--hairline);
  }
  @media (max-width: 520px) {
    .prose :global(.embed-card) { flex-direction: column-reverse; }
    .prose :global(.embed-card__thumb) { flex-basis: 160px; max-width: 100%; width: 100%;
      border-left: 0; border-bottom: 1px solid var(--hairline); }
  }
  @media (max-width: 640px) { h1 { font-size: 1.9rem; } }
</style>
