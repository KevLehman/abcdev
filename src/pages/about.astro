---
import Base from '../layouts/Base.astro';
const stack = [
  'JavaScript', 'TypeScript', 'Go', 'SQL', 'Bash',
  'Node.js', 'Astro', 'React', 'Fastify', 'Express',
  'PostgreSQL', 'MongoDB', 'SQLite',
  'Docker', 'AWS', 'DigitalOcean', 'Netlify', 'Caddy', 'Linux',
  'GitHub Actions', 'Telegram Bots', 'AI agents', 'Git', 'Vim',
];
---
<Base title="About — Kev's logbook" description="Kevin Aleman — backend & systems engineer in El Salvador." active="about">
  <div class="wrap about">
    <p class="eyebrow">// about</p>
    <h1>About me</h1>
    <p class="lead">I'm a backend & systems developer living in El Salvador. I'm a passionate learner of new
      technologies and things that make my life easier. My goal is to build tools that help everyone — even in
      poorer countries like mine — get access to knowledge.</p>
    <section class="projects" aria-labelledby="projects-heading">
      <h2 id="projects-heading">Things I've built</h2>
      <article class="project">
        <h3>ReadStats</h3>
        <p>Apple Books holds a lot of reading history, but it's hard to see the whole picture.
          I mapped its SQLite databases and built a macOS menu-bar app to explore reading progress,
          unfinished books, and highlights.</p>
        <a href="/the-apple-books-data-model-1f8h">Read the data model walkthrough</a>
      </article>
      <article class="project">
        <h3>Visible Ads</h3>
        <p>I built a Chrome extension that adds a blue border to Google search ads, making them easier
          to spot. The accompanying tutorial walks through the manifest, background scripts, and
          content scripts.</p>
        <div class="project-links">
          <a href="https://github.com/KevLehman/visible-ads">View the source</a>
          <a href="/how-to-make-a-chrome-extension">Read the walkthrough</a>
        </div>
      </article>
    </section>
    <h2>What I work with</h2>
    <ul class="stack">{stack.map((s) => <li>{s}</li>)}</ul>
  </div>
</Base>
<style>
  .about { max-width: var(--measure); padding-top: 48px; }
  h1 { font-family: var(--font-display); font-weight: 700; font-size: 2.4rem; margin: 14px 0 18px; }
  h2 { font-family: var(--font-display); font-weight: 500; font-size: 1.3rem; margin: 2rem 0 1rem; }
  .lead { font-size: 1.2rem; line-height: 1.7; }
  .project { padding: 20px 0; border-top: 1px solid var(--hairline); }
  .project h3 { font-family: var(--font-display); font-size: 1.15rem; font-weight: 500; }
  .project p { margin: 8px 0 12px; font-size: 1.1rem; line-height: 1.65; }
  .project a { font-family: var(--font-mono); font-size: .78rem; }
  .project-links { display: flex; flex-wrap: wrap; gap: 10px 20px; }
  .stack { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .stack li { font-family: var(--font-mono); font-size: .78rem; color: var(--slate);
    border: 1px solid var(--hairline); padding: 5px 10px; }
</style>
