---
import Base from '../../layouts/Base.astro';
---
<Base title="Message sent — Kev's logbook" description="Thanks for getting in touch with Kevin Aleman." active="contact" noindex>
  <div class="wrap sent">
    <p class="eyebrow">// contact</p>
    <h1>Message sent.</h1>
    <p>Thanks for getting in touch. I'll reply to the email address you shared.</p>
    <a href="/">Back to the logbook</a>
  </div>
</Base>
<style>
  .sent { max-width: var(--measure); padding-top: 48px; padding-bottom: 32px; }
  h1 { font-family: var(--font-display); font-weight: 700; font-size: 2.4rem; margin: 14px 0 18px; }
  .sent > p:not(.eyebrow) { font-size: 1.2rem; line-height: 1.7; margin-bottom: 24px; }
  .sent > a { font-family: var(--font-mono); font-size: .85rem; }
</style>
