---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LogbookList from '../../components/LogbookList.astro';
import { articlePath } from '../../lib/article-language.mjs';

const articles = (await getCollection('articles', ({ data }) => data.lang === 'es' && !data.draft && !data.unlisted))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const startHere = [
  'in-the-ai-era-code-is-cheap-reputation-isnt-3482',
  'a-tale-of-candy-crush-technical-debt-143h',
  'from-js-to-go-i',
];
const featured = startHere.flatMap((slug) => articles.filter((article) => article.data.translationOf === slug));
const entries = await Promise.all(articles.map(async (article) => {
  const { remarkPluginFrontmatter } = await render(article);
  return {
    idx: article.data.idx, slug: articlePath(article).slice(1, -1), date: article.data.date,
    tags: article.data.tags, title: article.data.title,
    rt: remarkPluginFrontmatter.minutesRead ?? '1 min read',
  };
}));
---
<Base title="Kevin Aleman — Bitácora" description="Una bitácora sobre código, juegos y vida." active="logbook" lang="es">
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">// bitácora personal</p>
      <h1 class="thesis">Escribo sobre vida, ingeniería e <em>inteligencia artificial</em>.</h1>
      <p class="sub">Ingeniero en El Salvador. Una bitácora sobre lo que construyo, juego y aprendo.</p>
    </section>
    {featured.length > 0 && (
      <section class="start" aria-labelledby="start-heading">
        <h2 id="start-heading">Empieza aquí</h2>
        <p class="start-intro">Algunas entradas para conocer la bitácora.</p>
        <ul class="picks">
          {featured.map((article) => (
            <li>
              <a class="pick" href={`${articlePath(article)}?lang=es`}>
                <span class="pick-meta">bitácora / {String(article.data.idx).padStart(3, '0')}</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.excerpt}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    {entries.length ? <LogbookList entries={entries} lang="es" /> : <p class="empty">Todavía no hay artículos en español.</p>}
  </div>
</Base>
<style>
  .hero { padding: 64px 0 40px; border-bottom: 1px solid var(--hairline); }
  .thesis { font-family: var(--font-display); font-weight: 500; font-size: 3.1rem;
    line-height: 1.04; letter-spacing: -.02em; max-width: 18ch; margin-top: 18px; }
  .thesis em { font-family: var(--font-body); font-style: italic; font-weight: 400; color: var(--signal); }
  .sub { margin-top: 20px; color: var(--slate); font-size: 1.05rem; max-width: 52ch; }
  .empty { margin-top: 20px; color: var(--slate); }
  .start { padding: 32px 0; border-bottom: 1px solid var(--hairline); }
  .start h2 { font-family: var(--font-display); font-weight: 500; font-size: 1.4rem; }
  .start-intro { color: var(--slate); margin-top: 4px; }
  .picks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px;
    list-style: none; margin-top: 22px; }
  .pick { display: block; height: 100%; padding-left: 16px; border-left: 2px solid var(--hairline);
    color: var(--graphite); text-decoration: none; }
  .pick:hover { border-color: var(--signal); }
  .pick:hover h3 { color: var(--signal); }
  .pick-meta { font-family: var(--font-mono); font-size: .72rem; color: var(--slate); }
  .pick h3 { font-family: var(--font-display); font-size: 1.1rem; font-weight: 500;
    line-height: 1.3; margin-top: 8px; }
  .pick p { color: var(--slate); margin-top: 10px; font-size: 1rem; }
  @media (max-width: 640px) {
    .hero { padding: 40px 0 28px; }
    .thesis { font-size: 2.2rem; }
    .sub { font-size: 1rem; }
    .picks { grid-template-columns: 1fr; gap: 22px; }
  }
</style>
