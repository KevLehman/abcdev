---
import { getCollection } from 'astro:content';
import Article from '../[slug].astro';
import { articlePath, translationFor } from '../../lib/article-language.mjs';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.filter((article) => article.data.lang === 'es' && translationFor(article, articles))
    .map((article) => ({ params: { slug: articlePath(article).slice(1, -1) }, props: { article } }));
}
const { article } = Astro.props;
---
<Article article={article} />
